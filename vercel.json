{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "bgimage/**,drawing/**,public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/bgimage/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/drawing/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
